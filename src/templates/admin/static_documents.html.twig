{% extends 'base.html.twig' %}

{% block title %}Achats internes - Documents statiques{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .example-admin-card{border-radius:18px;border:1px solid #eee;box-shadow:0 10px 22px rgba(0,0,0,.05);overflow:hidden}
    .example-admin-btn{border-radius:12px;font-weight:700}
    .example-code{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono",monospace;font-size:.85rem;background:#f8f9fa;border:1px solid #eee;border-radius:8px;padding:.25rem .45rem;display:inline-block}
    .example-upload-box{min-width:280px}
    @media (max-width:768px){.example-upload-box{min-width:100%}}
  </style>
{% endblock %}

{% block body %}
<div class="container py-4 py-md-5">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold mb-1">Achats internes - Documents statiques</h1>
      <div class="text-muted">Gestion des fichiers affiches dans le formulaire de demande.</div>
    </div>
    <a href="{{ path('open_demat_example_admin_hub') }}" class="btn btn-outline-secondary example-admin-btn">
      Retour admin
    </a>
  </div>

  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="alert alert-{{ label }} mb-3">{{ message }}</div>
    {% endfor %}
  {% endfor %}

  <div class="card example-admin-card">
    <div class="card-header d-flex justify-content-between align-items-center bg-white">
      <div class="fw-semibold">Documents du formulaire</div>
      <div class="text-muted small">{{ rows|length }} document(s)</div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Document</th>
              <th>Fichier actuel</th>
              <th style="width:420px;">Remplacer le fichier</th>
              <th class="text-end" style="width:180px;">Actions</th>
            </tr>
          </thead>
          <tbody>
          {% for row in rows %}
            {% set staticDocument = row.document %}
            {% set coreDocument = staticDocument ? staticDocument.document : null %}
            <tr>
              <td>
                <div class="fw-semibold">{{ row.label }}</div>
                <div class="text-muted small mb-2">{{ row.description }}</div>
                <span class="example-code">{{ row.code }}</span>
              </td>
              <td>
                {% if staticDocument and coreDocument %}
                  <div class="fw-semibold">{{ coreDocument.originalName ?: 'Document sans nom' }}</div>
                  <div class="text-muted small">Type : {{ coreDocument.mimeType ?: '-' }}</div>
                  <div class="text-muted small">
                    Taille :
                    {% if coreDocument.sizeBytes %}
                      {{ (coreDocument.sizeBytes / 1024)|number_format(1, ',', ' ') }} Ko
                    {% else %}
                      -
                    {% endif %}
                  </div>
                  <div class="mt-2"><span class="badge bg-success">Disponible</span></div>
                {% else %}
                  <span class="badge bg-warning text-dark">Non configure</span>
                {% endif %}
              </td>
              <td>
                <form method="post"
                      action="{{ path('open_demat_example_admin_static_document_upload', {code: row.code}) }}"
                      enctype="multipart/form-data"
                      class="example-upload-box">
                  <input type="hidden" name="_token" value="{{ csrf_token('example_static_document_upload_' ~ row.code) }}">
                  <div class="input-group">
                    <input type="file" name="file" class="form-control" accept="application/pdf" required>
                    <button type="submit" class="btn btn-primary example-admin-btn">Envoyer</button>
                  </div>
                  <div class="text-muted small mt-1">Format accepte : PDF, 10 Mo maximum.</div>
                </form>
              </td>
              <td class="text-end">
                {% if staticDocument %}
                  <a href="{{ path('open_demat_static_document', {code: row.code}) }}" class="btn btn-outline-secondary btn-sm example-admin-btn" target="_blank" rel="noopener">
                    Consulter
                  </a>
                {% else %}
                  <span class="text-muted small">Aucune action</span>
                {% endif %}
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="4" class="text-center text-muted py-4">Aucun document configure.</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
{% endblock %}
