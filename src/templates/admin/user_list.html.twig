{% extends 'base.html.twig' %}

{% block title %}Achats internes - Utilisateurs{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .example-admin-card{border-radius:18px;border:1px solid #eee;box-shadow:0 10px 22px rgba(0,0,0,.05);overflow:hidden}
    .example-admin-btn{border-radius:12px;font-weight:700}
    .example-badge-state{border-radius:999px;padding:.45rem .65rem;font-weight:700}
  </style>
{% endblock %}

{% block body %}
<div class="container py-4 py-md-5">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
      <h1 class="h3 fw-bold mb-1">Achats internes - Utilisateurs</h1>
      <div class="text-muted">Gestion des comptes habilites Example</div>
    </div>

    <div class="d-flex gap-2 flex-wrap">
      <a href="{{ path('open_demat_example_admin_hub') }}" class="btn btn-outline-secondary example-admin-btn">
        Retour admin
      </a>
      <a href="{{ path('open_demat_example_admin_user_new') }}" class="btn btn-primary example-admin-btn">
        Nouvel utilisateur
      </a>
    </div>
  </div>

  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="alert alert-{{ label }} mb-3">{{ message }}</div>
    {% endfor %}
  {% endfor %}

  {% include '_partials/_list_table_tools.html.twig' with {
    uid: 'example_users',
    search_placeholder: 'Rechercher un utilisateur...',
    filter_label_selector: true,
    filters: [
      ['ALL', 'Tous', 'btn-outline-primary'],
      ['ROLE_EXAMPLE_GESTIONNAIRE', 'Gestionnaire', 'btn-outline-secondary']
    ],
    config: {
      items: '.js-list-item',
      search: {
        input: '#example_users_search',
        fieldsAttr: 'data-search'
      },
      filter: {
        attr: 'data-status',
        buttons: '.js-filter-btn',
        label: '.js-filter-label',
        countSpans: '.js-count',
        default: 'ALL'
      },
      sort: {
        headers: '.js-sort',
        defaultKey: 'username',
        defaultDir: 'asc'
      }
    },
    search_id: 'example_users_search'
  } %}

  <div class="card example-admin-card">
    <div class="card-header d-flex justify-content-between align-items-center bg-white">
      <div class="fw-semibold">Utilisateurs Example</div>
      <div class="text-muted small">{{ users|length }} resultat(s)</div>
    </div>

    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="js-sort" data-sort-key="id" data-sort-type="number" style="width:100px;">ID</th>
              <th class="js-sort" data-sort-key="username" data-sort-type="text">Identifiant</th>
              <th class="js-sort" data-sort-key="email" data-sort-type="text">E-mail</th>
              <th style="width:260px;">Role</th>
              <th class="text-end" style="width:260px;">Actions</th>
            </tr>
          </thead>
          <tbody>
          {% for user in users %}
            {% set username = user.username ?? user.userIdentifier %}
            {% set email = user.email ?? '' %}
            {% set exampleRoles = user.roles|filter(r => r starts with 'ROLE_EXAMPLE_')|filter(r => r != 'ROLE_EXAMPLE_ADMIN' and r != 'ROLE_EXAMPLE_POWERUSER') %}
            {% set statusForFilter = exampleRoles|first ?: 'NONE' %}
            <tr class="js-list-item"
                data-status="{{ statusForFilter }}"
                data-search="{{ user.id }} {{ username }} {{ email }} {{ exampleRoles|join(' ') }}"
                data-id="{{ user.id }}"
                data-username="{{ username }}"
                data-email="{{ email }}">
              <td class="fw-semibold">#{{ user.id }}</td>
              <td>{{ username }}</td>
              <td>{{ email ?: '-' }}</td>
              <td>
                {% if exampleRoles is not empty %}
                  <div class="d-flex flex-wrap gap-1">
                    {% for role in exampleRoles %}
                      <span class="badge bg-secondary example-badge-state">
                        {{ role == 'ROLE_EXAMPLE_GESTIONNAIRE' ? 'Gestionnaire' : role }}
                      </span>
                    {% endfor %}
                  </div>
                {% else %}
                  <span class="text-muted">-</span>
                {% endif %}
              </td>
              <td class="text-end">
                <div class="d-flex justify-content-end gap-2 flex-wrap">
                  <a href="{{ path('open_demat_example_admin_user_edit', {id: user.id}) }}" class="btn btn-outline-primary example-admin-btn">
                    Editer
                  </a>
                  <form method="post"
                        action="{{ path('open_demat_example_admin_user_delete', {id: user.id}) }}"
                        onsubmit="return confirm('Supprimer les roles Example de cet utilisateur ?');"
                        class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('example_delete_user_' ~ user.id) }}">
                    <button type="submit" class="btn btn-outline-danger example-admin-btn">
                      Supprimer
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="5" class="text-center text-muted py-4">Aucun utilisateur Example.</td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      <div id="emptyState" class="d-none text-center text-muted py-4">
        Aucun resultat pour les filtres actuels.
      </div>
    </div>
  </div>
</div>
{% endblock %}
