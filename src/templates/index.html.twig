{% extends 'base.html.twig' %}

{% block title %}Achats internes{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .example-home .hero-card,
    .example-home .list-card,
    .example-home .stat-card{
      border:1px solid #eee;
      border-radius:18px;
      box-shadow:0 .55rem 1.35rem rgba(0,0,0,.07);
      background:#fff;
      overflow:hidden;
    }
    .example-home .hero-card{
      background:linear-gradient(180deg,#fff,#fafafa);
    }
    .example-home .hero-card .card-body{padding:2rem}
    .example-home .hero-title{font-weight:850;font-size:clamp(1.45rem,1.1rem + 1.7vw,2.25rem)}
    .example-home .hero-lead{color:#666;max-width:72ch;margin-inline:auto}
    .example-home .btn-main{border-radius:12px;font-weight:750}
    .example-home .stat-card{padding:1rem;height:100%}
    .example-home .stat-k{font-size:.86rem;color:#666;font-weight:650}
    .example-home .stat-v{font-size:1.55rem;font-weight:900}
    .example-home .badge-status{font-weight:800;border:1px solid #eee}
    .example-home .status-brouillon{background:#fff8e1;color:#664d03}
    .example-home .status-soumise{background:#fdecef;color:#9f1d2b}
    .example-home .status-a-corriger{background:#fff8e1;color:#664d03}
    .example-home .status-validee{background:#eaf6ef;color:#0f5132}
    .example-home .status-refusee{background:#fdecef;color:#842029}
    .example-home .status-annulee{background:#f1f3f5;color:#343a40}
    .example-home .status-terminee{background:#eaf2ff;color:#084298}
  </style>
{% endblock %}

{% block body %}
{% set state_labels = {
  'brouillon': 'Brouillon',
  'soumise': 'Soumise',
  'a_corriger': 'A corriger',
  'validee': 'Validee',
  'refusee': 'Refusee',
  'annulee': 'Annulee',
  'terminee': 'Terminee'
} %}

<div class="container py-5 example-home">
  <div class="card hero-card mb-4">
    <div class="card-body text-center">
      <h1 class="hero-title">Demandes d achat interne</h1>
      <p class="hero-lead mb-4">
        {% if is_global_list %}
          Consultez et traitez les demandes d achat interne soumises par les services.
        {% else %}
          Deposez une demande d achat interne et suivez son avancement.
        {% endif %}
      </p>
      <a class="btn btn-danger btn-main" href="{{ path('open_demat_example_demande_achat_new') }}">
        <i class="bx bx-plus" aria-hidden="true"></i>
        Nouvelle demande
      </a>
      {% if is_granted('ROLE_EXAMPLE_POWERUSER') %}
        <a class="btn btn-outline-danger btn-main ms-2" href="{{ path('open_demat_example_admin_hub') }}">
          <i class="bx bx-cog" aria-hidden="true"></i>
          Administration
        </a>
      {% endif %}
    </div>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="stat-card"><div class="stat-k">Total</div><div class="stat-v">{{ stats.total }}</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><div class="stat-k">Soumises</div><div class="stat-v">{{ stats.soumise }}</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><div class="stat-k">A corriger</div><div class="stat-v">{{ stats.a_corriger }}</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><div class="stat-k">Cloturees</div><div class="stat-v">{{ stats.validee + stats.refusee + stats.annulee + stats.terminee }}</div></div></div>
  </div>

  <div class="card list-card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
      <h2 class="h5 mb-0">Demandes</h2>
      <span class="text-muted small">{{ is_global_list ? 'Vue gestionnaire' : 'Mes demandes' }}</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>#</th>
            <th>Statut</th>
            <th>Demandeur</th>
            <th>Service</th>
            <th>Besoin</th>
            <th>Montant</th>
            <th>Date besoin</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
        {% for demande in demandes %}
          {% set statut = demande.statutTraitement ?: 'brouillon' %}
          <tr>
            <td>{{ demande.id }}</td>
            <td><span class="badge badge-status status-{{ statut|replace({'_':'-'}) }}">{{ state_labels[statut]|default(statut) }}</span></td>
            <td>{{ demande.demandeur }}</td>
            <td>{{ demande.serviceDemandeur }}</td>
            <td>{{ demande.intituleBesoin }}</td>
            <td>{{ demande.montantEstime }} EUR</td>
            <td>{{ demande.dateBesoin ? demande.dateBesoin|date('d/m/Y') : '-' }}</td>
            <td class="text-end">
              <a class="btn btn-sm btn-outline-secondary" href="{{ path('open_demat_example_demande_achat_show', {id: demande.id}) }}">Ouvrir</a>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="8" class="text-center text-muted py-4">Aucune demande.</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
